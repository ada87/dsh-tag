{
  "name": "dsh-tag",
  "version": "0.1.0",
  "description": "Color tags for DSH sessions and workspaces: context-menu tags, colored titles, a sidebar filter bar, and 8 UI languages.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "README.ja.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "tags",
    "session",
    "workspace",
    "sidebar",
    "filter"
  ],
  "license": "MIT",
  "author": "ada87",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ada87/dsh-tag.git"
  },
  "homepage": "https://github.com/ada87/dsh-tag#readme",
  "bugs": {
    "url": "https://github.com/ada87/dsh-tag/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs && npm run check:client",
    "dev": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:client": "node --check client/client.js",
    "test:host": "node scripts/smoke.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
